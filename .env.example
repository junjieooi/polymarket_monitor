# Telegram Configuration
# Get BOT_TOKEN from @BotFather on Telegram
# Get CHAT_ID by running fetch_chatID.py after messaging your bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
ENABLE_TELEGRAM=true

# Volume Spike Thresholds
# Alert when volume increases by this percentage
VOLUME_PERCENT_THRESHOLD=300
# Alert when volume increases by this USD amount
VOLUME_ABSOLUTE_THRESHOLD=50000

# Suspicious Activity Detection
# Minimum USD value to flag as a large bet
LARGE_BET_THRESHOLD=10000
# Maximum trades for a wallet to be considered "fresh"
FRESH_WALLET_MAX_TRADES=5
# Number of political market entries to trigger repeat alert
POLITICAL_REPEAT_THRESHOLD=3

# Monitoring Settings
# How often to check for new events/volume spikes (seconds)
CHECK_INTERVAL_SECONDS=120

# State File (stores tracking data between restarts)
# Set to empty string to disable persistence
STATE_FILE=polymarket_state.json

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
